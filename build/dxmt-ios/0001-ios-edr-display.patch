+#if TARGET_OS_IOS
+/* MADEIRA ml1271: HDR is opt-in on iOS (env.MADEIRA_HDR = 1 in madeira.cfg). */
+static int
+madeira_hdr_wanted(void) {
+  static int v = -1;
+  if (v < 0) {
+    const char *e = getenv("MADEIRA_HDR");
+    v = e && e[0] == '1';
+  }
+  return v;
+}
+
+/* The panel's EDR headroom (peak over SDR white), read once on the main thread. */
+static float
+madeira_edr_headroom(void) {
+  static float h = 0.0f;
+  if (h == 0.0f) {
+    __block float r = 1.0f;
+    execute_on_main(^{
+      if (@available(iOS 16.0, *))
+        r = (float)UIScreen.mainScreen.potentialEDRHeadroom;
+    });
+    h = r > 1.0f ? r : 1.0f;
+  }
+  return h;
+}
+#endif
