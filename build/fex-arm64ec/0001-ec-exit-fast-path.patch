diff --git a/Source/Windows/ARM64EC/IosJitAlias.cpp b/Source/Windows/ARM64EC/IosJitAlias.cpp
index 61d7a23..fff2e7b 100644
--- a/Source/Windows/ARM64EC/IosJitAlias.cpp
+++ b/Source/Windows/ARM64EC/IosJitAlias.cpp
@@ -49,11 +49,28 @@ volatile int IosAliasCount = 0;
  * runtime) are registered late, so oldest-first cost ~150 iterations per
  * x64->EC call at up to a million calls a second. */
 IosAliasEntry* volatile IosAliasLast = nullptr;
+/* Per-64KB-page hint for ExitFunctionEC: slot ((va >> 16) ^ (va >> 28)) & 4095
+ * holds the entry that last translated an address in that page. Module.S
+ * range-checks the entry before using it, so a stale or colliding slot only
+ * costs the walk. Unlike IosAliasLast it is written on a miss only, so the
+ * steady state is read-only and shared by every thread. Cleared whenever an
+ * entry is retired or reused (see IosAliasHintClear). */
+IosAliasEntry* volatile IosAliasHint[4096];
 }
 
 namespace {
 IosAliasEntry* const g_Entries = IosAliasEntries;
 volatile int& g_EntryCount = IosAliasCount;
+
+// Drop every page hint before an entry's fields change, so ExitFunctionEC
+// stops reaching a slot that is being retired or refilled. Image loads are
+// rare; 4096 stores each time is nothing next to the copy into the pool.
+void IosAliasHintClear() {
+  for (auto& Hint : IosAliasHint) {
+    Hint = nullptr;
+  }
+  __sync_synchronize();
+}
 }  // namespace
 
 extern "C" {
@@ -393,12 +410,14 @@ void BTCpu64IosAddAliasMapping(uint64_t PeBase, uint64_t JitBase, uint64_t Size)
     if (pb < PeBase + Size && PeBase < pb + sz) {
       g_Entries[i].Size = 0;
       __sync_synchronize();
+      IosAliasHintClear();
     }
   }
 
   // Prefer a retired slot so long-running processes don't exhaust the table.
   for (int i = 0; i < count; i++) {
     if (!g_Entries[i].Size) {
+      IosAliasHintClear();
       g_Entries[i].PeBase = PeBase;
       g_Entries[i].JitBase = JitBase;
       __sync_synchronize();
